# Copy to .env (gitignored) and fill in. A variable already set in the shell wins over this file.
# Never commit a filled copy: it holds private keys.

# --- Chain -------------------------------------------------------------------
# A Sepolia JSON-RPC endpoint (chain id 11155111). Every mode.
SEPOLIA_RPC_URL=

# --- The Sepolia deployment (every mode) -------------------------------------
# The policy manager.
MANAGER_ADDRESS=
# The wallet (ECDSA) method, the only method the sample's guardians use.
METHOD_ECDSA_ADDRESS=
# The passkey method (named in the descriptor, never used by the sample's rule).
METHOD_PASSKEY_ADDRESS=
# The identity methods; leave empty for the zero address (they are not deployed by the demo script).
METHOD_AADHAAR_ADDRESS=
METHOD_ZKPASSPORT_ADDRESS=
# The Ambire recovery action.
ACTION_ADDRESS=
# The Ambire account implementation the action serves.
AMBIRE_IMPLEMENTATION_ADDRESS=
# The block the manager was deployed in.
DEPLOY_BLOCK=
# Optional: the manager release the descriptor expects; the run stops when version() differs. Empty: take the chain's.
MANAGER_VERSION=

# --- The holder's account ----------------------------------------------------
# existing | create | eoa   (default existing)
#   existing: an Ambire account the holder key already holds; the setup arms it.
#   create:   the sample creates one through Ambire's factory (the AMBIRE_* inputs below); untested.
#   eoa:      the holder's own address stands in; reads and prepares only, no account self-call is sent.
ACCOUNT_MODE=existing
# Mode existing: the Ambire account address.
ACCOUNT_ADDRESS=
# Mode create: the factory, the full creation code (proxy plus the holder's privilege write), the 32-byte salt,
# the factory's deploy function as a human-readable ABI item taking (bytes code, uint256 salt), and (optional) the block an already-created account was created in.
AMBIRE_FACTORY=
AMBIRE_CREATION_CODE=
AMBIRE_SALT=
AMBIRE_FACTORY_DEPLOY_FUNCTION=
AMBIRE_ACCOUNT_CREATED_AT=

# --- Keys (0x-prefixed 32-byte private keys) ---------------------------------
# The key the account holds now. Sends the account's own calls (commit, cancel by owner). Needs Sepolia ETH.
HOLDER_PRIVATE_KEY=
# The key a recovery hands the account to. After a handover the two keys swap roles, so fund it too.
NEW_HOLDER_PRIVATE_KEY=
# Sends the permissionless calls (start, cancel by proofs, execute) and, in mode create, the factory deploy. Needs Sepolia ETH.
SPONSOR_PRIVATE_KEY=
# The wallet guardians, comma-separated; they only sign, no ETH needed.
GUARDIAN_PRIVATE_KEYS=
# How many guardians the rule requires (default 2).
GUARDIAN_THRESHOLD=2

# --- Setup -------------------------------------------------------------------
# The wait the setup commits, in seconds (default 120: a short wait, the SDK warns).
SETUP_WAIT=120
# The password of the encrypted backup the setup commits and the recovery restores from.
BACKUP_PASSWORD=

# --- Recovery ----------------------------------------------------------------
# The payment order's ERC-20 token (the zero address for the native asset) and amount in base units; the account must hold it.
ORDER_TOKEN=
ORDER_AMOUNT=0
# Optional: who the order pays; empty pays the sponsor.
ORDER_PAYEE=
